<?jelly escape-by-default='true'?>
<!-- SPEC item 6a: the activation request form. The action is the one that can change anything
     (ACTIVATE when the job is not activated, HOLD when it is), posted as the "action" query
     parameter with the reason and the repeated "approvers" field to JobActivationForm#doSubmit.
     The page body is _body.jelly. -->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <l:userExperimentalFlag var="newJobPage" flagClassName="jenkins.model.experimentalflags.NewJobPageUserExperimentalFlag"/>
  <!-- e2e-14 DEF-08: on the new job page, the job's classic sidepanel lists core's URL-less
       new-job-page actions (a second "Delete Pipeline", "Permalinks") as dead links. A job is
       therefore rendered as a job sub-page there, as JobRequestAction/index.jelly does: the
       job's build bar, tabs and app bar actions above the form and no sidepanel. A computed
       folder (D-46c) is not a job and has no new job page, so it keeps the classic layout, as
       does every item for a user on the classic job page. -->
  <j:set var="jobSubpage" value="${newJobPage and !it.folder}"/>
  <j:choose>
    <j:when test="${jobSubpage}">
      <!-- l:job-subpage takes no permissions attribute, so the check l:layout permissions="..."
           makes is made here, against the same nearest access-controlled ancestor, the job.
           #132: through it, not h, which is only defined inside l:layout (l:view). -->
      ${it.checkViewPermission()}
      <l:job-subpage>
        <st:include page="_body.jelly"/>
      </l:job-subpage>
    </j:when>
    <j:otherwise>
      <l:layout title="Activation - ${it.item.fullDisplayName}" permissions="${it.viewPermissions}">
        <st:include page="sidepanel.jelly" it="${it.item}"/>
        <!-- e2e-03 DEF-06 / D-64: this action is the "Activation" crumb after the item's; no
             crumb leads to the run request form. -->
        <l:main-panel>
          <st:include page="_body.jelly"/>
        </l:main-panel>
      </l:layout>
    </j:otherwise>
  </j:choose>
</j:jelly>
