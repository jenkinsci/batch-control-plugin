<?jelly escape-by-default='true'?>
<!-- D-66 (R4-8): the Grants screen lists pending requests, then active and ended permission
     windows, one row per request, each linking to its detail page. The request form opens in
     core's dialog from the app bar; the old prefill links of this page (?scopeFullName=, ?from=)
     are redirected to the form page (GrantsSection#getLegacyFormQuery). Short cells
     do not wrap at 1280 px, only free text does; the Scope, Actions and Approvers cells wrap
     between the kind and the name, or after a ", ", so each table fits the content width. D-71: the Scope column shows the one item a
     request or window names, with its kind (tags/scopeItem.jelly). D-74: a row with a window names
     the window's item, which follows the item when it is renamed or moved; deleting the item ends
     the window, so an active window simply shows its remaining time. D-75 (1), S-39-04: a followed
     name only to a viewer who may read the item, otherwise the approved name with a fixed note
     (GrantsSection.Row#getShownScope); the rows carry no other trace of the new location. -->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout"
         xmlns:bc="/io/jenkins/plugins/batchcontrol/tags">
  <j:set var="legacyQuery" value="${it.legacyFormQuery}"/>
  <j:choose>
    <j:when test="${legacyQuery != null}">
      <st:redirect url="new?${legacyQuery}"/>
    </j:when>
    <j:otherwise>
  <l:layout title="Grants" type="one-column" permissions="${it.viewPermissions}">
    <l:main-panel>
      <j:set var="base" value="${rootURL}/batch-control/grants/"/>
      <!-- D-74: short cells and date parts are styled by the plugin stylesheet's classes. -->
      <st:adjunct includes="io.jenkins.plugins.batchcontrol.ui.batch-control"/>
      <l:app-bar title="Grants">
        <j:if test="${it.canRequest}">
          <button type="button" class="jenkins-button jenkins-button--primary" data-type="dialog-opener"
                  data-dialog-url="${base}dialog" data-batch-control-request="grant">
            <l:icon src="symbol-add"/>
            Request Change Permission
          </button>
        </j:if>
      </l:app-bar>
      <bc:tabs active="grants"/>
      <p class="jenkins-description">
        Temporary (just-in-time) permission windows, each for one job or folder: the requests
        awaiting a decision, the windows open now and the ones that have ended.
      </p>

      <h2>Pending Requests</h2>
      <j:choose>
        <j:when test="${it.pendingTotal == 0}">
          <p>No pending requests.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table jenkins-table--small jenkins-!-margin-bottom-0" data-batch-control-list="pending">
            <thead>
              <tr class="batch-control-nowrap">
                <th>ID</th>
                <th>Scope</th>
                <th>Actions</th>
                <th>Duration</th>
                <th>Reason</th>
                <th>Requester</th>
                <th>Approvers</th>
                <th>Created</th>
              </tr>
            </thead>
            <tbody>
              <j:forEach var="r" items="${it.pendingItems}">
                <tr>
                  <td class="batch-control-nowrap"><bc:idLink href="${base}${r.id}/" value="${r.id}"/></td>
                  <td><bc:scopeItem scope="${r.shownScope}" kind="${r.itemKind}"/></td>
                  <td>${it.join(r.actions)}</td>
                  <td class="batch-control-nowrap">${r.request.durationMinutes} min</td>
                  <td>${r.request.reason}</td>
                  <td class="batch-control-nowrap">${r.user}</td>
                  <td><j:forEach var="approver" items="${r.request.approvers}" varStatus="st">${st.index > 0 ? ', ' : ''}<span class="batch-control-nowrap">${approver}</span></j:forEach></td>
                  <td><j:forEach var="part" items="${it.formatParts(r.request.createdAt)}"><span class="batch-control-date-part">${part}</span><wbr/></j:forEach></td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
          <bc:pager param="pendingPage" page="${it.pendingPage}" total="${it.pendingTotal}"
                    hasPrevious="${it.hasPendingPrevious}" hasNext="${it.hasPendingNext}" label="pending requests" singular="request" plural="requests"/>
        </j:otherwise>
      </j:choose>

      <h2 class="jenkins-!-margin-top-3">Active</h2>
      <p class="jenkins-description">
        Remaining time is measured when the page is rendered; reload to refresh it.
      </p>
      <j:choose>
        <j:when test="${it.activeTotal == 0}">
          <p>No active grants.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table jenkins-table--small jenkins-!-margin-bottom-0" data-batch-control-list="active">
            <thead>
              <tr class="batch-control-nowrap">
                <th>ID</th>
                <th>User</th>
                <th>Scope</th>
                <th>Actions</th>
                <th title="New job names a Create window allows">Names</th>
                <th>Granted</th>
                <th>Expires</th>
                <th>Remaining</th>
                <j:if test="${it.canRevoke}">
                  <th/>
                </j:if>
              </tr>
            </thead>
            <tbody>
              <j:forEach var="r" items="${it.activeItems}">
                <j:set var="g" value="${r.grant}"/>
                <tr>
                  <td class="batch-control-nowrap">
                    <j:choose>
                      <j:when test="${r.linked}"><bc:idLink href="${base}${r.id}/" value="${r.id}"/></j:when>
                      <j:otherwise><bc:idLink value="${r.id}"/></j:otherwise>
                    </j:choose>
                  </td>
                  <td class="batch-control-nowrap">${g.user}</td>
                  <td><bc:scopeItem scope="${r.shownScope}" kind="${r.itemKind}"/></td>
                  <td>${it.join(g.actions)}</td>
                  <td class="batch-control-nowrap"><code>${it.createNameLabel(r)}</code></td>
                  <td><j:forEach var="part" items="${it.formatParts(g.grantedAt)}"><span class="batch-control-date-part">${part}</span><wbr/></j:forEach></td>
                  <td><j:forEach var="part" items="${it.formatParts(g.expiresAt)}"><span class="batch-control-date-part">${part}</span><wbr/></j:forEach></td>
                  <td class="batch-control-nowrap">${it.remaining(g.expiresAt)}</td>
                  <j:if test="${it.canRevoke}">
                    <td class="batch-control-nowrap">
                      <l:confirmationLink class="jenkins-button jenkins-button--tertiary jenkins-!-destructive-color" destructive="true" href="${base}active/${g.id}/revoke" post="true"
                                          title="Revoke this grant?" okText="Revoke"
                                          message="The user immediately loses the granted permissions. This cannot be undone.">
                        Revoke
                      </l:confirmationLink>
                    </td>
                  </j:if>
                </tr>
              </j:forEach>
            </tbody>
          </table>
          <bc:pager param="activePage" page="${it.activePage}" total="${it.activeTotal}"
                    hasPrevious="${it.hasActivePrevious}" hasNext="${it.hasActiveNext}" label="active grants" singular="active grant" plural="active grants"/>
        </j:otherwise>
      </j:choose>

      <!-- DEF-18 (SPEC item 8, D-33): ended windows, with a re-request button that opens the form
           prefilled from the ended grant (resolved from the store, the caller's own grants only;
           never echoed from the query string). Requests that never became a window (rejected,
           cancelled, expired) end here too. -->
      <h2 class="jenkins-!-margin-top-3">Ended</h2>
      <j:choose>
        <j:when test="${it.endedTotal == 0}">
          <p>No ended grants or requests.</p>
        </j:when>
        <j:otherwise>
          <table class="jenkins-table jenkins-table--small jenkins-!-margin-bottom-0" data-batch-control-list="ended">
            <thead>
              <tr class="batch-control-nowrap">
                <th>ID</th>
                <th>User</th>
                <th>Scope</th>
                <th>Actions</th>
                <th title="New job names a Create window allows">Names</th>
                <th>Ended</th>
                <th>How</th>
                <th/>
              </tr>
            </thead>
            <tbody>
              <j:forEach var="r" items="${it.endedItems}">
                <tr>
                  <td class="batch-control-nowrap">
                    <j:choose>
                      <j:when test="${r.linked}"><bc:idLink href="${base}${r.id}/" value="${r.id}"/></j:when>
                      <j:otherwise><bc:idLink value="${r.id}"/></j:otherwise>
                    </j:choose>
                  </td>
                  <td class="batch-control-nowrap">${r.user}</td>
                  <td><bc:scopeItem scope="${r.shownScope}" kind="${r.itemKind}"/></td>
                  <td>${it.join(r.actions)}</td>
                  <td class="batch-control-nowrap"><code>${it.createNameLabel(r)}</code></td>
                  <td><j:forEach var="part" items="${it.formatParts(it.endedAt(r))}"><span class="batch-control-date-part">${part}</span><wbr/></j:forEach></td>
                  <!-- #18.2: the badge of the request's status, in this list's wording (howEnded).
                       ended: an approved request here is one whose window has ended, so it is
                       neutral. A window without a stored request has no status: plain text. -->
                  <td>
                    <j:choose>
                      <j:when test="${r.requestStatus != null}"><bc:status value="${r.requestStatus}" label="${it.howEnded(r)}" ended="true"/></j:when>
                      <j:otherwise>${it.howEnded(r)}</j:otherwise>
                    </j:choose>
                  </td>
                  <td class="batch-control-nowrap">
                    <j:if test="${it.isCanRenew(r)}">
                      <button type="button" class="jenkins-button jenkins-button--tertiary" data-type="dialog-opener"
                              data-dialog-url="${base}dialog?from=${r.id}">Request again</button>
                    </j:if>
                  </td>
                </tr>
              </j:forEach>
            </tbody>
          </table>
          <bc:pager param="endedPage" page="${it.endedPage}" total="${it.endedTotal}"
                    hasPrevious="${it.hasEndedPrevious}" hasNext="${it.hasEndedNext}" label="ended grants and requests" singular="ended item" plural="ended items"/>
        </j:otherwise>
      </j:choose>
    </l:main-panel>
  </l:layout>
    </j:otherwise>
  </j:choose>
</j:jelly>
