<?jelly escape-by-default='true'?>
<!-- Hosting review 2026-10-02 (PR6): the Batch Control sections as tabs at the top of every
     Batch Control screen, instead of a side panel. The entries and badges come from
     ui.SectionTabs, the same list as the breadcrumb dropdown of BatchControlRootAction, so a tab
     is shown only when its section can be opened. Labels and badge texts are constants or
     numbers; everything is escaped by default. A tab whose page title differs
     ("Changes" opens "Change Records") carries the title as tooltip.
     Hosting review round 3 (R4-7): the same look as core's other tab bars. Core's l:tabs (used by
     the new build page, run-subpage.jelly) is documented "experimental, internal", so its markup
     is reproduced instead, as core's own new dashboard view tabs (DefaultViewsTabBar) do: an
     "app-build-tabs" container of design-library buttons, tertiary unless current, with l:icon
     and l:badge. Core's CSS makes the current tab inert (pointer-events: none); on a detail page
     (a request, an incident, the monthly summary) the highlighted tab is a way back to its list,
     so it stays clickable there.
     e2e-11 (as e2e-06 UX-8): eight tabs with three badges must fit one row at 1280 px, so the
     buttons are a little tighter than core's default padding. -->
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib:layout">
  <st:documentation>
    The Batch Control tab bar.
    <st:attribute name="active" use="required">
      Id of the current section: overview, requests, activations, grants, changes, dashboard,
      incidents or history.
    </st:attribute>
  </st:documentation>
  <j:invokeStatic var="bcTabs" className="io.jenkins.plugins.batchcontrol.ui.SectionTabs" method="current"/>
  <j:set var="bcPath" value="${request2.requestURI}"/>
  <nav class="app-build-tabs jenkins-!-margin-bottom-3" aria-label="Batch Control sections" data-batch-control-tabs="true">
    <j:forEach var="tab" items="${bcTabs}">
      <j:set var="current" value="${tab.id == attrs.active}"/>
      <j:set var="tabUrl" value="${rootURL}/batch-control/${tab.urlName}"/>
      <j:set var="tabIndexUrl" value="${rootURL}/batch-control/${tab.urlName}index"/>
      <j:set var="onTabPage" value="${current and (bcPath == tabUrl or bcPath == tabIndexUrl)}"/>
      <a href="${tabUrl}"
         class="jenkins-button ${current ? '' : 'jenkins-button--tertiary'}"
         style="padding-inline: 0.75rem;${current and !onTabPage ? ' pointer-events: auto;' : ''}"
         aria-current="${current ? (onTabPage ? 'page' : 'location') : null}" data-batch-control-tab="${tab.id}"
         title="${tab.title}">
        <l:icon src="${tab.iconFileName}"/>
        ${tab.displayName}
        <l:badge badge="${tab.badge}"/>
      </a>
    </j:forEach>
  </nav>
</j:jelly>
